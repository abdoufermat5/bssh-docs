---
// What happens to one agent call, left to right. The step marked `human` is the one that
// waits for a person when the policy asks; it gets the accent. Text comes from the page,
// so each language passes its own.
interface Step {
	title: string;
	detail: string;
	human?: boolean;
}
interface Props {
	/** Accessible name of the list, e.g. "What happens to one agent call". */
	label: string;
	steps: Step[];
}
const { label, steps } = Astro.props;
---

<ol class="ai-flow" aria-label={label}>
	{
		steps.map((step, i) => (
			<li class:list={['ai-flow-step', { human: step.human }]}>
				<span class="ai-flow-index" aria-hidden="true">
					{String(i + 1).padStart(2, '0')}
				</span>
				<span class="ai-flow-title">{step.title}</span>
				<span class="ai-flow-detail">{step.detail}</span>
			</li>
		))
	}
</ol>

<style>
	.ai-flow {
		--gap: 0.5rem;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--gap);
		list-style: none;
		padding: 0;
		margin-block: 1.75rem 2rem;
		counter-reset: none;
	}
	.ai-flow-step {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		margin: 0;
		padding: 0.875rem 0.875rem 1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 8px;
		background: transparent;
	}
	/* A thin connector between steps of the same row on wide screens. */
	.ai-flow-step:not(:last-child, :nth-child(3n))::after {
		content: '';
		position: absolute;
		top: 1.35rem;
		inset-inline-end: calc(-1 * var(--gap) - 1px);
		width: calc(var(--gap) + 2px);
		height: 1px;
		background: var(--sl-color-gray-4);
	}
	.ai-flow-step.human {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.ai-flow-index {
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
	.human .ai-flow-index {
		color: var(--sl-color-accent);
	}
	.ai-flow-title {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.ai-flow-detail {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--sl-color-gray-2);
	}
	.human .ai-flow-detail {
		color: var(--sl-color-gray-1);
	}

	/* Stacked on narrow screens: the connector turns vertical. */
	@media (max-width: 42rem) {
		.ai-flow {
			grid-template-columns: 1fr;
		}
		.ai-flow-step {
			display: grid;
			grid-template-columns: 2rem 1fr;
			column-gap: 0.5rem;
			row-gap: 0.25rem;
		}
		.ai-flow-index {
			grid-row: span 2;
			padding-top: 0.15rem;
		}
		.ai-flow-step:not(:last-child)::after {
			content: '';
			position: absolute;
			background: var(--sl-color-gray-4);
			top: auto;
			bottom: calc(-1 * var(--gap) - 1px);
			inset-inline-end: auto;
			inset-inline-start: 1.6rem;
			width: 1px;
			height: calc(var(--gap) + 2px);
		}
	}
</style>
