---
// A recorded demo: real bssh sessions against throwaway servers.
// Homepage demos play muted in a loop; with reduced motion they stay on the poster and
// show controls. Demos inside pages start on their poster and play when asked.
interface Props {
	/** What the video shows, for screen readers (in the page's language). */
	label: string;
	/** Defaults to the homepage demo. */
	src?: string;
	poster?: string;
	/** Shown under a demo inside a page. */
	caption?: string;
	/** Play muted in a loop, as on the homepage. On by default for the homepage demo. */
	loop?: boolean;
}
const {
	label,
	src = '/demo/bssh-demo.mp4',
	poster = '/demo/bssh-demo.jpg',
	caption,
	loop,
} = Astro.props;
const hero = loop ?? src === '/demo/bssh-demo.mp4';
---

{
	hero ? (
		<video
			class="landing-shot landing-demo"
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			poster={poster}
			aria-label={label}
		>
			<source src={src} type="video/mp4" />
		</video>
	) : (
		<figure class="page-demo">
			<video controls muted playsinline preload="none" poster={poster} aria-label={label}>
				<source src={src} type="video/mp4" />
			</video>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	)
}

<script>
	if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const video of document.querySelectorAll<HTMLVideoElement>('video.landing-demo')) {
			video.removeAttribute('autoplay');
			video.pause();
			video.controls = true;
		}
	}
</script>

<style>
	.page-demo {
		margin: 1.75rem 0 2rem;
	}
	.page-demo video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		border-radius: 8px;
		border: 1px solid var(--sl-color-hairline-light);
		background: #111113;
	}
	.page-demo figcaption {
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
</style>
