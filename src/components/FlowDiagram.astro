---
// A small left-to-right architecture diagram: boxes joined by labelled arrows, with an
// optional dashed region around some of them (a private network, "your infrastructure").
// HTML rather than SVG so the text stays readable on a phone, where it stacks vertically.
// Text comes from the page, so each language passes its own.
interface Node {
	title: string;
	detail?: string;
	/** `accent` for the one element the diagram is about. */
	tone?: 'default' | 'accent';
}
interface Props {
	/** Accessible name, e.g. "Where your data goes with bssh Teams". */
	label: string;
	nodes: Node[];
	/** One label per gap between nodes: `links[i]` joins `nodes[i]` and `nodes[i + 1]`. */
	links: string[];
	/** Dashed region around `nodes[from..=to]`, with its own label. */
	group?: { from: number; to: number; label: string };
	caption?: string;
}
const { label, nodes, links, group, caption } = Astro.props;

type Item =
	| { kind: 'node'; node: Node }
	| { kind: 'link'; text: string }
	| { kind: 'group'; label: string; items: Item[]; size: number };

const items: Item[] = [];
let current: Item[] = items;
nodes.forEach((node, i) => {
	if (group && i === group.from) {
		const size = group.to - group.from + 1;
		const g: Item = { kind: 'group', label: group.label, items: [], size };
		items.push(g);
		current = g.items;
	}
	current.push({ kind: 'node', node });
	if (group && i === group.to) current = items;
	if (i < links.length) current.push({ kind: 'link', text: links[i] });
});
---

<figure class="flow-diagram" role="group" aria-label={label}>
	<div class="fd-row">
		{
			items.map((item) =>
				item.kind === 'node' ? (
					<div class:list={['fd-node', item.node.tone === 'accent' && 'fd-accent']}>
						<span class="fd-title">{item.node.title}</span>
						{item.node.detail && <span class="fd-detail">{item.node.detail}</span>}
					</div>
				) : item.kind === 'link' ? (
					<div class="fd-link">
						<span class="fd-link-text">{item.text}</span>
						<span class="fd-arrow" aria-hidden="true" />
					</div>
				) : (
					<div
						class="fd-group"
						style={`flex: ${item.size} 1 calc(${item.size - 1} * var(--fd-link) + 1.25rem)`}
					>
						<span class="fd-group-label">{item.label}</span>
						<div class="fd-row">
							{item.items.map((sub) =>
								sub.kind === 'node' ? (
									<div class:list={['fd-node', sub.node.tone === 'accent' && 'fd-accent']}>
										<span class="fd-title">{sub.node.title}</span>
										{sub.node.detail && <span class="fd-detail">{sub.node.detail}</span>}
									</div>
								) : sub.kind === 'link' ? (
									<div class="fd-link">
										<span class="fd-link-text">{sub.text}</span>
										<span class="fd-arrow" aria-hidden="true" />
									</div>
								) : null
							)}
						</div>
					</div>
				)
			)
		}
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.flow-diagram {
		--fd-link: 6.25rem;
		margin: 1.75rem 0 2rem;
	}
	.fd-row {
		display: flex;
		align-items: stretch;
	}
	.fd-node {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.3rem;
		padding: 0.75rem 0.875rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 8px;
	}
	.fd-accent {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.fd-title {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.fd-detail {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--sl-color-gray-2);
	}
	.fd-accent .fd-detail {
		color: var(--sl-color-gray-1);
	}
	.fd-link {
		flex: 0 0 var(--fd-link);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 0.3rem;
		padding: 0 0.375rem;
		text-align: center;
	}
	.fd-link-text {
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		line-height: 1.35;
		color: var(--sl-color-gray-3);
	}
	.fd-arrow {
		position: relative;
		width: 100%;
		height: 1px;
		background: var(--sl-color-gray-4);
	}
	.fd-arrow::after {
		content: '';
		position: absolute;
		inset-inline-end: 0;
		top: -3px;
		border: 3.5px solid transparent;
		border-inline-start: 6px solid var(--sl-color-gray-4);
		border-inline-end: 0;
	}
	/* A group grows like the nodes it holds, on top of the width of its own arrows. */
	.fd-group {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.625rem;
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 10px;
	}
	.fd-group > .fd-row {
		flex: 1;
	}
	.fd-group-label {
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}
	figcaption {
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}

	/* Stacked on narrow screens: arrows point down. */
	@media (max-width: 42rem) {
		.fd-row {
			flex-direction: column;
		}
		.fd-group {
			flex: none !important;
		}
		.fd-link {
			flex: 0 0 auto;
			flex-direction: row;
			justify-content: flex-start;
			gap: 0.625rem;
			padding: 0.375rem 0 0.375rem 1.25rem;
			text-align: start;
		}
		.fd-arrow {
			order: -1;
			width: 1px;
			height: 1.75rem;
			flex: 0 0 auto;
		}
		.fd-arrow::after {
			inset-inline-end: auto;
			top: auto;
			bottom: 0;
			left: -3px;
			border: 3.5px solid transparent;
			border-top: 6px solid var(--sl-color-gray-4);
			border-bottom: 0;
		}
	}
</style>
